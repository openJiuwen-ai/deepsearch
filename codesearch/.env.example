# openJiuwen-CodeSearch 环境变量模板（复制为 .env 或在部署环境中导出）
# 全部变量在 CodeSearchConfig.from_env() 调用时读取（非 import 时），
# 缺省值见 config/ 各模型定义。

# LLM（检索必需；索引默认稀疏模式不需要）
OPENROUTER_API_KEY=

# Milvus（默认本机默认端口；与 deepsearch 共用实例时保持一致即可，
# codesearch 只读写 cs_ 前缀命名空间）
MILVUS_HOST=localhost
MILVUS_PORT=19530
# 共用实例开启鉴权时填写（支持 "user:password" 或 API token）
MILVUS_TOKEN=

# 服务形态（仅 server extra 需要；前缀 CODESEARCH_）
CODESEARCH_HOST=0.0.0.0
CODESEARCH_PORT=8100
CODESEARCH_LOG_LEVEL=INFO

# 服务形态：允许被索引的根目录白名单（os.pathsep 分隔）。
# 留空 = /api/v1/index 一律拒绝。服务无鉴权，务必按最小范围配置。
CODESEARCH_INDEX_ROOTS=
