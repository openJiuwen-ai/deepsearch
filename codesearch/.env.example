# openJiuwen-CodeSearch 环境变量模板（复制为 .env 或在部署环境中导出）
# 全部变量在 CodeSearchConfig.from_env() 调用时读取（非 import 时），
# 缺省值见 config/ 各模型定义。进程环境优先于 .env。
# Retropus 字段完整说明：docs/feature/framework/retropus-agent.md

# ---- LLM（OpenAI 兼容端点；所有引擎共用）----
# OpenRouter key 需配合 OpenRouter base URL + provider/model id。
MODEL=openai/gpt-5-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-your-openrouter-api-key
TEMPERATURE=0

# ---- Milvus（graph/react 引擎；agent.engine=retropus 时忽略）----
MILVUS_HOST=localhost
MILVUS_PORT=19530
# 共用实例开启鉴权时填写（支持 "user:password" 或 API token）
MILVUS_TOKEN=

# ---- 服务形态（仅 server extra；前缀 CODESEARCH_）----
CODESEARCH_HOST=0.0.0.0
CODESEARCH_PORT=8100
CODESEARCH_LOG_LEVEL=INFO
# 允许被索引的根目录白名单（os.pathsep 分隔）。
# 留空 = /api/v1/index 一律拒绝。服务无鉴权，务必按最小范围配置。
CODESEARCH_INDEX_ROOTS=

# ---- Retropus knowledge-graph build（CodeSearchConfig.retropus）----
# AST depth must be deep enough to capture function/class definition nodes.
MAX_AST_DEPTH=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---- Retropus agent loop bounds ----
MAX_TOOL_CALLS=24
MAX_ROUNDS=12
MAX_FINAL_SPANS=25
MAX_OBS_CHARS=6000
MAX_READ_LINES=400
MIN_SPANS_BEFORE_FINISH=3
MIN_FILES_BEFORE_FINISH=1
# Pad final spans from top BM25 defs when fewer than N (0 = off; empty-only legacy top-5 still runs)
MIN_MANDATORY_RETURN_SPANS=0
# Alias also accepted: RETROPUS_MIN_MANDATORY_RETURN_SPANS

# ---- Retropus improvement flags (0/1). Only inherits_expand defaults ON in code. ----
# IMP_ALL=0 forces every flag off first; then individual IMP_* overrides apply.
# IMP_ALL=0
# IMP_BAN_TESTS=1
# IMP_ANTI_EARLY_FINISH=1
# IMP_SAME_FILE_EXPAND=1
# IMP_SECOND_FILE_PROBE=1
# IMP_INHERITS_EXPAND=1
# IMP_EXPAND_IMPORTS=1
# IMP_DELETE_SNIPPETS=1

# ---- Engine selection ----
# Not an env var: set CodeSearchConfig.agent.engine = "retropus" in code, or
# pass --engine retropus to benchmarks.contextbench.runner / CLI as supported.
