# openJiuwen-CodeSearch 环境变量模板（复制为 .env 或在部署环境中导出）
# 全部变量在 CodeSearchConfig.from_env() 调用时读取（非 import 时），
# 缺省值见 config/ 各模型定义。.env 中的键覆盖同名 export。
# Retropus 字段完整说明：docs/feature/framework/retropus-agent.md

# ---------- LLM（OpenAI 兼容；检索必需，默认稀疏索引不需要）----------
# api_key + base_url 必填；模型可选（不设则用默认）
CODESEARCH_LLM_API_KEY=
CODESEARCH_LLM_BASE_URL=
# 默认：main=openai/gpt-5（检索决策），filter=openai/gpt-5-mini（逐行提取）
# CODESEARCH_LLM_MODEL=openai/gpt-5
# CODESEARCH_FILTER_LLM_MODEL=openai/gpt-5-mini

# ---------- Milvus（graph/react 引擎；agent.engine=retropus 时忽略）----------
# 默认本机端口；与 deepsearch 共用实例时保持一致即可（codesearch 只用 cs_ 前缀）
MILVUS_HOST=localhost
MILVUS_PORT=19530
# 共用实例开启鉴权时填写（支持 "user:password" 或 API token）
MILVUS_TOKEN=

# ---------- 服务形态（仅 server extra；前缀 CODESEARCH_）----------
CODESEARCH_HOST=0.0.0.0
CODESEARCH_PORT=8100
CODESEARCH_LOG_LEVEL=INFO

# 允许被索引的根目录白名单（os.pathsep 分隔）。
# 留空 = /api/v1/index 一律返回 403（安全默认值，不是故障）。
# 服务无鉴权，务必按最小范围配置，并部署在可信网络或网关之后。
CODESEARCH_INDEX_ROOTS=

# ---------- Retropus knowledge-graph build（CodeSearchConfig.retropus）----------
# AST depth must be deep enough to capture function/class definition nodes.
MAX_AST_DEPTH=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# On-disk dump of KG + BM25 (per collection). Empty string disables persistence.
RETROPUS_INDEX_DIR=./output/retropus

# ---------- Retropus agent loop bounds ----------
MAX_TOOL_CALLS=24
MAX_ROUNDS=12
MAX_FINAL_SPANS=25
MAX_OBS_CHARS=6000
MAX_READ_LINES=400
MIN_SPANS_BEFORE_FINISH=3
MIN_FILES_BEFORE_FINISH=1
# Pad final spans from top BM25 defs when fewer than N (0 = off; empty-only legacy top-5 still runs)
MIN_MANDATORY_RETURN_SPANS=0
# Alias also accepted: RETROPUS_MIN_MANDATORY_RETURN_SPANS

# ---------- Retropus feature flags (0/1). Only inherits_expand defaults ON in code. ----------
# FEAT_ALL=0 forces every flag off first; then individual FEAT_* overrides apply.
# FEAT_ALL=0
# FEAT_BAN_TESTS=1
# FEAT_ANTI_EARLY_FINISH=1
# FEAT_SAME_FILE_EXPAND=1
# FEAT_SECOND_FILE_PROBE=1
# FEAT_INHERITS_EXPAND=1
# FEAT_EXPAND_IMPORTS=1
# FEAT_DELETE_SNIPPETS=1

# ---------- Engine selection ----------
# Not an env var for SDK default. Set CodeSearchConfig.agent.engine = "retropus"
# in code, pass --engine retropus to `codesearch` / ContextBench, or pass
# "engine": "retropus" on HTTP POST /api/v1/index and /api/v1/search (default
# remains "auto"; Retropus is never the server default).
