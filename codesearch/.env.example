# ---------- LLM（OpenAI 兼容；检索必需，默认稀疏索引不需要）----------
# api_key + base_url 必填；模型可选（不设则用默认）
CODESEARCH_LLM_API_KEY=
CODESEARCH_LLM_BASE_URL=
# 默认：main=openai/gpt-5（检索决策），filter=openai/gpt-5-mini（逐行提取）
# CODESEARCH_LLM_MODEL=openai/gpt-5
# CODESEARCH_FILTER_LLM_MODEL=openai/gpt-5-mini

# ---------- Milvus ----------
# 默认本机端口；与 deepsearch 共用实例时保持一致即可（codesearch 只用 cs_ 前缀）
MILVUS_HOST=localhost
MILVUS_PORT=19530
# 共用实例开启鉴权时填写（支持 "user:password" 或 API token）
MILVUS_TOKEN=

# ---------- 服务形态（仅 server extra；前缀 CODESEARCH_）----------
CODESEARCH_HOST=0.0.0.0
CODESEARCH_PORT=8100
CODESEARCH_LOG_LEVEL=INFO

# 允许被索引的根目录白名单（os.pathsep 分隔）。
# 留空 = /api/v1/index 一律返回 403（安全默认值，不是故障）。
# 服务无鉴权，务必按最小范围配置，并部署在可信网络或网关之后。
CODESEARCH_INDEX_ROOTS=
