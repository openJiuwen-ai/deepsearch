# Retropus / CodeSearch env template (copy to codesearch/.env or export in your shell).
# Process env wins over .env. Loaded by CodeSearchConfig.from_env().
# Full Retropus field reference: docs/feature/framework/retropus-agent.md

# ---- LLM (OpenAI-compatible endpoint; shared by all engines) ----
# OpenRouter key requires the OpenRouter base URL + provider/model id.
MODEL=openai/gpt-5-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-your-openrouter-api-key
TEMPERATURE=0

# ---- Retropus knowledge-graph build (CodeSearchConfig.retropus) ----
# AST depth must be deep enough to capture function/class definition nodes.
MAX_AST_DEPTH=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---- Retropus retrieval backend: only "bm25" is supported ----
RETRIEVER=bm25
# CODE_AWARE_TOKENIZER=0
# TOKENIZE_WORKERS=4

# ---- Retropus agent loop bounds ----
MAX_TOOL_CALLS=24
MAX_ROUNDS=12
MAX_FINAL_SPANS=25
MAX_OBS_CHARS=6000
MAX_READ_LINES=400
MIN_SPANS_BEFORE_FINISH=3
MIN_FILES_BEFORE_FINISH=1
# Pad final spans from top BM25 defs when fewer than N (0 = off; empty-only legacy top-5 still runs)
MIN_MANDATORY_RETURN_SPANS=0
# Alias also accepted: RETROPUS_MIN_MANDATORY_RETURN_SPANS

# ---- Retropus improvement flags (0/1). Only inherits_expand defaults ON in code. ----
# IMP_ALL=0 forces every flag off first; then individual IMP_* overrides apply.
# IMP_ALL=0
# IMP_BAN_TESTS=1
# IMP_ANTI_EARLY_FINISH=1
# IMP_SAME_FILE_EXPAND=1
# IMP_SECOND_FILE_PROBE=1
# IMP_INHERITS_EXPAND=1

# ---- Milvus (graph/react engines only; ignored when agent.engine=retropus) ----
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_TOKEN=

# ---- Engine selection ----
# Not an env var: set CodeSearchConfig.agent.engine = "retropus" in code, or
# pass --engine retropus to benchmarks.contextbench.runner / CLI as supported.
